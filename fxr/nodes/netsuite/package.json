{
	"name": "n8n-nodes-fxr-netsuite",
	"version": "0.2.0",
	"description": "n8n community nodes for NetSuite: SuiteTalk REST records (typed fields or JSON), SuiteQL, Saved Searches via RESTlet, raw requests, and a polling trigger. Token-Based Auth or OAuth 2.0 M2M.",
	"keywords": [
		"n8n-community-node-package",
		"netsuite",
		"suiteql",
		"suitetalk",
		"erp"
	],
	"license": "MIT",
	"author": {
		"name": "FXR Racing"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"files": [
		"dist",
		"suitescript"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/NetSuiteTokenApi.credentials.js",
			"dist/credentials/NetSuiteOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/NetSuite/NetSuite.node.js",
			"dist/nodes/NetSuite/NetSuiteTrigger.node.js"
		]
	},
	"scripts": {
		"build": "tsc && node scripts/copy-assets.mjs",
		"dev": "tsc --watch",
		"test": "jest",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@types/node": "^20.17.50",
		"n8n-workflow": "^1.82.0",
		"typescript": "^5.8.0",
		"@types/jest": "^29.5.14",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
